FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

WORKDIR /backend

ENV UV_NO_DEV=1 UV_NO_CACHE=1

COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /uvx /bin/

RUN groupadd --gid 10001 app && useradd --uid 10001 --gid 10001 --no-create-home --no-log-init --home-dir /nonexistent --shell /usr/sbin/nologin app

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev --group vkbot

ENV UV_NO_SYNC=1
ENV UV_PYTHON_DOWNLOADS=never

COPY src/ ./src/
COPY start_message.txt ./
USER 10001:10001
