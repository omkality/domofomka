# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DB_NAME=codes.db
DADATA_TOKEN=your_dadata_token_here

# VK Bot Configuration
VK_GROUP_TOKEN=your_vk_group_token_here
VK_GROUP_ID=your_vk_group_id_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_EXPIRE_TIME=1200
ANTI_SPAM_TIME=5

# API for VK Bot
DOMOFOMKA_API_HOST=api
DOMOFOMKA_API_PORT=8000

# Optional private outbound proxy. Empty values keep direct connections.
DADATA_PROXY_URL=
VK_PROXY_URL=

# Network timeouts, retries and route recovery (seconds unless marked otherwise)
DADATA_TIMEOUT_SECONDS=8
DADATA_CONNECT_TIMEOUT_SECONDS=2
DADATA_FAILURE_COOLDOWN_SECONDS=30
PROXY_RETRY_INITIAL_SECONDS=30
PROXY_RETRY_MAX_SECONDS=300
PROXY_RETRY_MULTIPLIER=2
PROXY_PROBE_LEASE_SECONDS=60
VK_CONNECT_TIMEOUT_SECONDS=5
VK_READ_TIMEOUT_SECONDS=20
VK_RETRY_ATTEMPTS=3
VK_FALLBACK_ATTEMPTS=2
VK_RETRY_DELAY_SECONDS=1
VK_LONGPOLL_WAIT_SECONDS=25
VK_LONGPOLL_TIMEOUT_MARGIN_SECONDS=10
BOT_RESTART_DELAY_SECONDS=3
INTERNAL_API_CONNECT_TIMEOUT_SECONDS=5
INTERNAL_API_TIMEOUT_SECONDS=30
INTERNAL_API_GEO_TIMEOUT_SECONDS=30
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
