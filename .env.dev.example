# Скопируйте в .env.dev. Настоящие токены и пароли не коммитьте.
APP_ENVIRONMENT=development
# Деплой: общий бюджет готовности и свободное место, неприкосновенное для БД.
DEPLOY_HEALTH_TIMEOUT_SECONDS=120
DEPLOY_DISK_RESERVE_BYTES=268435456
# Разовое упорядочивание каталога по ручному запуску Actions; не таймауты поиска.
CATALOG_MAINTENANCE_TIMEOUT_SECONDS=180
CATALOG_MAINTENANCE_LOCK_TIMEOUT_SECONDS=5
CATALOG_MAINTENANCE_MEMORY_MB=16
VK_GROUP_ID=223949627
EXPECTED_VK_GROUP_ID=223949627
VK_GROUP_TOKEN=replace_with_test_community_token
DEV_FAULTS_ENABLED=true
POSTGRES_PASSWORD=replace_with_long_random_password
QUEUE_DATABASE_URL=postgresql://domofomka:${POSTGRES_PASSWORD}@queue:5432/domofomka
QUEUE_WORKERS=2
# Не более трёх разных ещё не начатых запросов пользователя; ответы с интервалом от 5 секунд.
QUEUE_MAX_PENDING_MESSAGES_PER_PEER=3
OUTBOX_PEER_MIN_INTERVAL_SECONDS=5
# Очистка тел завершённых заданий; идентификаторы дедупликации остаются.
QUEUE_RETENTION_DAYS=180
QUEUE_CONTEXT_RETENTION_DAYS=90
QUEUE_MAINTENANCE_INTERVAL_SECONDS=300
QUEUE_MAINTENANCE_BATCH=500
QUEUE_DISK_FREE_MIN_BYTES=268435456
QUEUE_BACKUP_KEEP_DAYS=3
QUEUE_BACKUP_MAX_COPIES=3
QUEUE_BACKUP_RESERVE_BYTES=268435456
QUEUE_DATABASE_WARN_BYTES=134217728
QUEUE_OLDEST_PENDING_WARN_SECONDS=120
GEO_RETRY_DELAY_SECONDS=60
GEO_RETRY_MAX_AGE_SECONDS=1800
QUEUE_LEASE_SECONDS=120
QUEUE_RETRY_BASE_SECONDS=5
QUEUE_RETRY_MAX_SECONDS=300
QUEUE_POLL_SECONDS=1
VK_MIN_INTERVAL_SECONDS=0.4
RECOVERY_INTERVAL_SECONDS=300
RECOVERY_OVERLAP_SECONDS=900
RECOVERY_BOOTSTRAP_SECONDS=86400
API_HOST=0.0.0.0
API_PORT=8000
WORKERS_NUM=1
DEV_API_PORT=18000
DB_NAME=codes.db
LEGACY_INDEX_PATH=/backend/catalog/legacy-index.db
DADATA_TOKEN=replace_with_dadata_token
ANTI_SPAM_TIME=5
DOMOFOMKA_API_HOST=api
DOMOFOMKA_API_PORT=8000

# Ограничения подтверждений нажатий для одного пользователя
CALLBACK_NOTICE_INTERVAL_SECONDS=10
CALLBACK_ACK_INTERVAL_SECONDS=1

# Необязательный закрытый прокси; пустое значение включает прямой запрос.
DADATA_PROXY_URL=
VK_PROXY_URL=

# Сетевые таймауты, повторы и восстановление маршрута; по умолчанию в секундах
DADATA_TIMEOUT_SECONDS=8
DADATA_CONNECT_TIMEOUT_SECONDS=2
DADATA_FAILURE_COOLDOWN_SECONDS=30
DADATA_ACCESS_COOLDOWN_SECONDS=3600
PROXY_RETRY_INITIAL_SECONDS=30
PROXY_RETRY_MAX_SECONDS=300
PROXY_RETRY_MULTIPLIER=2
PROXY_PROBE_LEASE_SECONDS=60
VK_CONNECT_TIMEOUT_SECONDS=5
VK_READ_TIMEOUT_SECONDS=20
VK_RETRY_ATTEMPTS=3
VK_FALLBACK_ATTEMPTS=2
VK_RETRY_DELAY_SECONDS=1
VK_LONGPOLL_WAIT_SECONDS=25
VK_LONGPOLL_TIMEOUT_MARGIN_SECONDS=10
BOT_RESTART_DELAY_SECONDS=3
INTERNAL_API_CONNECT_TIMEOUT_SECONDS=5
INTERNAL_API_TIMEOUT_SECONDS=30
INTERNAL_API_GEO_TIMEOUT_SECONDS=30

# Соединение с очередью и восстановление процесса бота
QUEUE_DB_CONNECT_TIMEOUT_SECONDS=5
QUEUE_DB_STATEMENT_TIMEOUT_MS=15000
QUEUE_DB_LOCK_TIMEOUT_MS=5000
QUEUE_GUARD_INTERVAL_SECONDS=2
QUEUE_HEARTBEAT_MIN_SECONDS=1
VK_ERROR_PAUSE_SECONDS=30

# Ресурсы контейнеров и проверки работоспособности
DOMOFOMKA_ENV_FILE=.env.dev
API_PUBLISH_PORT=18000
API_DEBUG=false
API_MEM_LIMIT=384m
API_MEMSWAP_LIMIT=512m
API_PIDS_LIMIT=128
BOT_MEM_LIMIT=128m
BOT_MEMSWAP_LIMIT=192m
BOT_PIDS_LIMIT=64
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
API_HEALTH_INTERVAL=20s
API_HEALTH_TIMEOUT=5s
API_HEALTH_RETRIES=5
API_HEALTH_START_PERIOD=60s

# Ресурсы постоянной очереди
QUEUE_MEM_LIMIT=192m
QUEUE_SHARED_BUFFERS=32MB
QUEUE_WORK_MEM=2MB
QUEUE_MAINTENANCE_WORK_MEM=16MB
QUEUE_AUTOVACUUM_WORKERS=1
QUEUE_MAX_CONNECTIONS=30
QUEUE_MAX_WAL_SIZE=128MB
QUEUE_MIN_WAL_SIZE=32MB
QUEUE_TEMP_FILE_LIMIT=128MB
QUEUE_MEMSWAP_LIMIT=256m
QUEUE_PIDS_LIMIT=64
QUEUE_HEALTH_INTERVAL=5s
QUEUE_HEALTH_TIMEOUT=3s
QUEUE_HEALTH_RETRIES=10

# Версионируемый поиск: адреса сервисов закрыты, при необходимости v2 использует v1
SEARCH_API_VERSION=v2
SEARCH_CATALOG_PATH=/backend/catalog/serving.db
SEARCH_BACKEND=postgres
# Отдельная загруженная БД; не используйте административную роль очереди.
CATALOG_DATABASE_URL=postgresql://catalog_reader:replace_with_reader_password@queue:5432/domofomka_catalog
CATALOG_CONNECT_TIMEOUT_SECONDS=3
CATALOG_STATEMENT_TIMEOUT_MS=2000
CATALOG_LOCK_TIMEOUT_SECONDS=2
CATALOG_OPERATION_TIMEOUT_SECONDS=5
OPENSEARCH_URL=
OPENSEARCH_INDEX=domofomka-buildings
OPENSEARCH_TIMEOUT_SECONDS=2
OPENSEARCH_FUZZINESS=AUTO
OPENSEARCH_PREFIX_LENGTH=1
# Бюджет кандидатов каждого прохода v2; чтение упакованных улиц использует до 10× этого числа.
SEARCH_CANDIDATE_LIMIT=100
SEARCH_MAX_QUERY_LENGTH=500
SEARCH_MIN_SIMILARITY=0.86
SEARCH_AMBIGUITY_MARGIN=0.06
# Кэш результатов v2 в каждом процессе API; TTL=0 выключает его.
SEARCH_CACHE_TTL_SECONDS=120
SEARCH_CACHE_MAX_ENTRIES=256
SEARCH_CACHE_MAX_BYTES=2097152

# Ограниченная диагностика в существующем PostgreSQL; без дополнительных сервисов.
TELEMETRY_ENABLED=true
TELEMETRY_MAX_SPANS=128
TELEMETRY_MAX_PACKET_BYTES=65536
TELEMETRY_QUERY_MAX_CHARS=2000
TELEMETRY_MAX_STORAGE_BYTES=536870912
TELEMETRY_DB_TIMEOUT_MS=500
APP_REVISION=unknown
CATALOG_REVISION=unknown

TELEMETRY_EVICTION_BATCH=500
