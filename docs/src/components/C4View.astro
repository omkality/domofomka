---
import type { LikeC4ViewId } from "likec4:react";
import C4Diagram from "./C4Diagram.tsx";
interface Props { viewId: LikeC4ViewId; variant?: "diagram" | "sequence"; }
const { viewId, variant } = Astro.props;
---
<figure class="c4-view not-content">
  <C4Diagram viewId={viewId} variant={variant} client:only="react" />
  <figcaption>Откройте диаграмму кликом. В схемах процессов кнопки Next / Previous показывают шаги.</figcaption>
</figure>
