[sqlfluff]
dialect = postgres
templater = raw
max_line_length = 120
rules = LT01,LT02,LT03,LT04,LT05,LT06,LT07,LT08,LT09,LT10,LT11,LT12,LT14,CP01,CP03,AL01,AL02,AM05

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 2
indented_using_on = True
indented_on_contents = False

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:layout.select_targets]
wildcard_policy = multiple
single_target_policy = new_line

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:ambiguous.join]
fully_qualify_join_types = both

[sqlfluff:layout:type:select_clause]
keyword_line_position = alone

[sqlfluff:layout:type:from_clause]
keyword_line_position = alone

[sqlfluff:layout:type:where_clause]
keyword_line_position = alone

[sqlfluff:layout:type:orderby_clause]
keyword_line_position = alone

[sqlfluff:layout:type:groupby_clause]
keyword_line_position = alone

[sqlfluff:layout:type:join_clause]
keyword_line_position = alone

[sqlfluff:layout:type:limit_clause]
keyword_line_position = alone
