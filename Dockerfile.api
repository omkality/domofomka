FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS dependencies

WORKDIR /backend

ENV UV_NO_DEV=1 UV_NO_CACHE=1

COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /bin/uv

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev --group api --group migrations

FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS runtime

WORKDIR /backend
ENV PATH="/backend/.venv/bin:${PATH}" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN groupadd --gid 10001 app && useradd --uid 10001 --gid 10001 --no-create-home --no-log-init --home-dir /nonexistent --shell /usr/sbin/nologin app

# Единственный статический HTTP-клиент вместо запуска Python в healthcheck.
COPY --from=busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478 /bin/busybox /usr/local/bin/wget
COPY --from=dependencies /backend/.venv /backend/.venv
COPY pyproject.toml uv.lock ./
COPY src/__init__.py ./src/__init__.py
COPY src/infrastructure/ ./src/infrastructure/
COPY src/code_service/ ./src/code_service/

# Исходная база v1 подключается Compose только для чтения; не дублируем её в образе.
USER 10001:10001
