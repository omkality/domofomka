FROM python:3.12-slim

WORKDIR /backend

ENV UV_NO_DEV=1 UV_NO_CACHE=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev --group api

ENV UV_NO_SYNC=1

COPY src/ ./src/
# Исходная база v1 подключается Compose только для чтения; не дублируем её в образе.
